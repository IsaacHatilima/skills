{
  "laracanon": {
    "repository": "IsaacHatilima/laracanon",
    "base": "main",
    "directory": "resources/agent-library",
    "adapter": "src/Items/LibraryCatalog.php",
    "agents": ["factory"],
    "groups": ["laravel"],
    "excludeGroups": [],
    "legacyDirectories": ["resources/items"]
  },
  "domain-driver": {
    "repository": "IsaacHatilima/domain-driver",
