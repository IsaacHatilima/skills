#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the project's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. checks.sh gets the base
ref as $FACTORY_BASE, so it can limit slow suites to what the branch changed.
The gate also fails when the branch modifies or deletes a file matching
config.json `protected_paths` (fnmatch patterns, where `*` also matches `/`).
Adding new files is fine.

Adapted from the ZazenCodes software factory v2 (GPLv3); see ../LICENSE.
"""

import sys

sys.dont_write_bytecode = True

import fnmatch  # noqa: E402
import json  # noqa: E402
import os  # noqa: E402
import subprocess  # noqa: E402
import time  # noqa: E402
from pathlib import Path  # noqa: E402

from factorylib.jobfiles import job_dir, read  # noqa: E402
from factorylib.project import Refused, base_branch, checks_script, config, require  # noqa: E402

TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        raise Refused(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--name-status", f"origin/{base_branch()}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in config()["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def run_checks(worktree):
    require(checks_script().exists(), f"{checks_script()} doesn't exist: run /factory setup")
    env = {**os.environ, "FACTORY_BASE": f"origin/{base_branch()}"}
    start = time.monotonic()
    res = subprocess.run(["bash", str(checks_script())], cwd=worktree, capture_output=True, text=True, env=env)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def report(commit, protected, code, log, seconds, name, merge):
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (f", synced with the latest {base_branch()} before merging" if merge else ""),
    ]
    text = (
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    return verdict, text


def gate(job_id, merge):
    job = read(job_id)
    worktree = job["worktree"]
    require(job["round"] >= 1, f"{job_id} hasn't started a build round")
    round_dir = job_dir(job_id) / f"round-{job['round']}"
    round_dir.mkdir(exist_ok=True)
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    code, log, seconds = run_checks(worktree)
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    verdict, text = report(commit, protected, code, log, seconds, name, merge)
    (round_dir / f"{name}.md").write_text(text)
    print(f"GATE: {verdict} ({job_id} round {job['round']}, checks.sh exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def hook_job_id(event):
    """The job id from the first prompt in the subagent's transcript, or None."""
    path = event.get("agent_transcript_path") or event.get("transcript_path")
    if not path:
        return None
    with open(Path(path).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    if "Job: " not in prompt:
        return None
    return prompt.split("Job: ", 1)[1].split(".", 1)[0].strip()


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    if event.get("cwd"):
        os.chdir(event["cwd"])
    try:
        job_id = hook_job_id(event)
        job = read(job_id) if job_id else None
    except (OSError, ValueError, KeyError, Refused):
        sys.exit(0)  # not a factory builder run
    if not job:
        sys.exit(0)
    code, log, _ = run_checks(job["worktree"])
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    try:
        if argv == ["--hook"]:
            hook()
        elif len(argv) == 1 and not argv[0].startswith("-"):
            gate(argv[0], merge=False)
        elif len(argv) == 2 and argv[1] == "--merge":
            gate(argv[0], merge=True)
        else:
            die(__doc__.strip())
    except Refused as e:
        die(str(e))


if __name__ == "__main__":
    main(sys.argv[1:])
