#!/usr/bin/env python3
"""The only writer of factory/jobs/<job-id>/job.json.

Every stage change goes through `advance`, which checks the files that justify
it and refuses anything else. GitHub side effects that belong to a transition
(labels, comments, the worktree, the merge) happen here too, so the
orchestrator never improvises them.

Usage:
  job init [--no-labels]         set up factory/ in this project (never overwrites config.json or checks.sh)
  job queue                      what /factory run should do with each labeled issue
  job create <issue>             new job for an open `factory` issue; prints the job id
  job header <job> [<role>]      the line every agent prompt starts with; role builder|ux|ui adds its port
  job advance <job> <stage>      move a job to <stage>, or refuse
  job merge <job>                APPROVE → sync with the base branch, gate, merge the PR
  job feedback <job>             needs-human → build (or spec, if blocked there), with your feedback (stdin) as feedback-<k>.md
  job reject <job>               needs-info or needs-human → rejected, with your reason (stdin) as rejection.md
  job agents <job> <json>        record the routed reviewers (called by bin/route)
  job sync <job>                 refresh reviews, gate and cost from the job's files
  job summary [<job>...]         table of jobs: issue, stage, PR, docs, cost, time

<job> is a job id (004-dark-mode) or an issue number (12).

Adapted from the ZazenCodes software factory v2 (GPLv3); see ../LICENSE.
"""

import sys

sys.dont_write_bytecode = True

import json  # noqa: E402
import re  # noqa: E402
import subprocess  # noqa: E402
from datetime import datetime, timezone  # noqa: E402
from pathlib import Path  # noqa: E402

from factorylib import github  # noqa: E402
from factorylib.jobfiles import (  # noqa: E402
    all_jobs, job_dir, now, prompt_header, resolve, save)
from factorylib.project import (  # noqa: E402
    SELECTION, Refused, base_branch, config, die, expand, jobs_dir, labels, repo, require, run)
from factorylib.setup import init  # noqa: E402
from factorylib.transitions import (  # noqa: E402
    TERMINAL, WAITING, advance, escalate, git, require_slot, running, sync)

BIN = Path(__file__).resolve().parent


def slugify(title):
    words = re.findall(r"[a-z0-9]+", title.lower())[:4]
    return "-".join(words) or "issue"


def resolve_skills():
    """The skill catalog, the factory's selection rules, and the library roots, as absolute paths."""
    skills = config().get("skills", {})
    catalog = expand(skills.get("catalog", ".ai/skills/catalog.md"))
    require(catalog.is_file(), f"the skill catalog {catalog} doesn't exist: install the shared skills "
                               "or set skills.catalog in factory/config.json")
    require(SELECTION.is_file(), f"the factory's skill selection {SELECTION} is missing: reinstall the factory")
    roots = [catalog.parent] + [expand(r) for r in skills.get("roots", [])]
    unique = list(dict.fromkeys(str(r) for r in roots if r.is_dir()))
    return {"catalog": str(catalog), "selection": str(SELECTION), "roots": unique}


def cmd_create(number):
    existing = [j for j in all_jobs(lock=False) if j["issue"] == int(number)]
    require(not existing, f"issue #{number} already has job {existing[0]['id']} ({existing[0]['stage']})"
            if existing else "")
    require_slot(None)
    skills = resolve_skills()
    issue = github.fetch_issue(number)
    require(issue["state"] == "OPEN", f"issue #{number} is {issue['state'].lower()}")
    require(labels()["queue"] in {lbl["name"] for lbl in issue["labels"]},
            f"issue #{number} isn't labeled {labels()['queue']}")
    jobs_dir().mkdir(parents=True, exist_ok=True)
    numbers = [int(p.name.split("-")[0]) for p in jobs_dir().iterdir() if p.name[:3].isdigit()]
    job_id = f"{max(numbers, default=0) + 1:03d}-{slugify(issue['title'])}"
    try:
        job_dir(job_id).mkdir()
    except FileExistsError:
        raise Refused(f"another session just took job {job_id}; run `job create {number}` again") from None
    job = {
        "id": job_id, "issue": issue["number"], "title": issue["title"], "issue_url": issue["url"],
        "pr": None, "pr_url": None,
        "branch": f"factory/{job_id}",
        "worktree": str(repo() / ".worktrees" / job_id),
        "stage": "intake", "round": 0, "round_limit": config()["max_rounds"], "round_base": None,
        "intake": None, "agents": None, "gate": None, "reviews": {},
        "outcome": None, "escalation": None, "doc": None, "doc_base": None, "doc_head": None,
        "skills": skills, "cost_usd": 0.0, "started": now(), "ended": None,
    }
    github.write_issue_md(job)
    save(job)
    print(job_id)


def queue_row(issue, job):
    n = issue["number"]
    if not job:
        return "new", ("new", n, "-", "-", issue["title"])
    stage = job["stage"]
    if stage == "needs-info":
        if github.replied_since_question(github.fetch_issue(n)):
            return "replied", ("resume", n, job["id"], stage, "author replied")
        return "other", ("wait", n, job["id"], stage, "waiting for the author")
    if stage == "needs-human":
        note = f"merge PR #{job['pr']}, or give feedback" if job["pr"] else "give feedback"
        return "other", ("wait", n, job["id"], stage, note)
    if stage == "rejected":
        return "other", ("skip", n, job["id"], stage, f"rejected; delete factory/jobs/{job['id']} to retry")
    if stage == "merged":
        return "other", ("skip", n, job["id"], stage, "merged")
    return "running", ("resume", n, job["id"], stage, f"round {job['round']}")


def cmd_queue():
    """Rows in the order to start them. `resume` and `new` rows fit in the
    concurrency slots; the rest show as `hold` until a running job finishes."""
    jobs = {j["issue"]: j for j in all_jobs()}
    # A job is done once its PR is merged on GitHub, which also closes the issue.
    for j in jobs.values():
        if j["stage"] not in TERMINAL and j["pr"] and github.pr_state(j) == "MERGED":
            save(advance(sync(j), "merged"))
    issues = github.gh_json("issue", "list", "--label", labels()["queue"], "--state", "open",
                            "--limit", "200", "--json", "number,title")
    open_numbers = {i["number"] for i in issues}
    groups = {"running": [], "replied": [], "new": [], "other": []}
    for issue in sorted(issues, key=lambda i: i["number"]):
        kind, row = queue_row(issue, jobs.get(issue["number"]))
        groups[kind].append(row)
    for n, j in sorted(jobs.items()):
        if n not in open_numbers and j["stage"] not in TERMINAL | WAITING:
            groups["other"].append(("skip", n, j["id"], j["stage"],
                                    f"issue is closed or no longer labeled {labels()['queue']}"))
    limit = config()["concurrency"]
    slots = limit - len(running(jobs.values()))
    rows = list(groups["running"])
    for row in groups["replied"] + groups["new"]:
        if slots > 0:
            rows.append(row)
            slots -= 1
        else:
            rows.append(("hold",) + row[1:4] + (f"concurrency {limit} reached",))
    for row in rows + groups["other"]:
        print("\t".join(str(c) for c in row))


def cmd_merge(job):
    sync(job)
    if job["stage"] == "approve":
        save(advance(job, "merging"))
    require(job["stage"] == "merging", f"{job['id']} is in {job['stage']}, not approve or merging")
    if job["pr"] and github.pr_state(job) == "MERGED":
        save(advance(sync(job), "merged"))
        print(f"{job['id']}: merged PR #{job['pr']}")
        return

    def fail(why):
        escalate(job, why)
        save(advance(sync(job), "needs-human"))
        print(f"{job['id']}: needs-human: {why.splitlines()[0]}")

    base = base_branch()
    git(job, "fetch", "origin", base)
    merged = git(job, "merge", "--no-edit", f"origin/{base}", check=False)
    if merged.returncode != 0:
        git(job, "merge", "--abort", check=False)
        return fail(f"The branch conflicts with {base}:\n\n```\n{merged.stdout.strip()}\n```")
    gate = subprocess.run([str(BIN / "gate"), job["id"], "--merge"], capture_output=True, text=True)
    if gate.returncode != 0:
        return fail(f"The gate failed after syncing with {base}. "
                    f"See round-{job['round']}/merge-checks.md.\n\n{(gate.stdout or gate.stderr).strip()}")
    try:
        git(job, "push", "origin", job["branch"])
        if github.pr_is_draft(job):
            github.gh("pr", "ready", str(job["pr"]))
        github.gh("pr", "merge", str(job["pr"]), f"--{config()['merge_method']}")
    except Refused as e:
        return fail(f"The merge failed:\n\n```\n{e}\n```")
    # GitHub may already have deleted the branch on merge.
    run(["git", "push", "origin", "--delete", job["branch"]], check=False)
    save(advance(sync(job), "merged"))
    print(f"{job['id']}: merged PR #{job['pr']}")


def cmd_feedback(job, text):
    require(job["stage"] == "needs-human", f"{job['id']} is in {job['stage']}, not needs-human")
    require(text.strip(), "no feedback on stdin")
    d = job_dir(job["id"])
    k = len(list(d.glob("feedback-*.md"))) + 1
    (d / f"feedback-{k}.md").write_text(
        f"# Feedback {k}\n\nFrom @{github.operator()} after the job escalated.\n\n{text.strip()}\n")
    # A job blocked at its spec was never built: its feedback goes to the spec-writer.
    stage = "spec" if job["round"] == 0 else "build"
    save(advance(sync(job), stage))
    where = "back to the spec-writer" if stage == "spec" else f"round {job['round']}"
    print(f"{job['id']}: feedback-{k}.md, {where}")


def cmd_reject(job, text):
    require(job["stage"] in WAITING, f"{job['id']} is in {job['stage']}, not needs-info or needs-human")
    require(text.strip(), "no reason on stdin")
    (job_dir(job["id"]) / "rejection.md").write_text(
        f"REJECTED\n\nBy @{github.operator()} while the job was {job['stage']}.\n\n{text.strip()}\n")
    save(advance(sync(job), "rejected"))
    print(f"{job['id']}: rejected")


def cmd_agents(job, spec):
    require(job["stage"] == "intake" and (job["intake"] or {}).get("decision") == "ACCEPT",
            f"{job['id']}: route only an intake job that intake ACCEPTed")
    agents = json.loads(spec)
    require(isinstance(agents.get("reviewers"), list) and agents["reviewers"],
            'expected {"reviewers": ["code", ...]}')
    job["agents"] = agents
    save(job)


def elapsed(job):
    start = datetime.fromisoformat(job["started"].replace("Z", "+00:00"))
    end = datetime.fromisoformat(job["ended"].replace("Z", "+00:00")) if job["ended"] else datetime.now(timezone.utc)
    minutes = int((end - start).total_seconds() // 60)
    return f"{minutes // 60}h{minutes % 60:02d}m" if minutes >= 60 else f"{minutes}m"


def cmd_summary(args):
    jobs = [resolve(a) for a in args] if args else all_jobs()
    rows = [("job", "issue", "stage", "round", "pr", "docs", "cost", "time")]
    for j in jobs:
        sync(j)  # for display only; the orchestrator owns the saved state
        rows.append((j["id"], f"#{j['issue']}", j["stage"], str(j["round"]),
                     f"#{j['pr']}" if j["pr"] else "-", j.get("doc") or "-",
                     f"${j['cost_usd']:.2f}", elapsed(j)))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths, strict=True)).rstrip())
    print(f"total ${sum(j['cost_usd'] for j in jobs):.2f} (API-equivalent, Claude Code factory agents only)")


def cmd_init(args):
    require(args in ([], ["--no-labels"]), "usage: job init [--no-labels]")
    report, ok = init(with_labels=not args)
    print("\n".join(report))
    if not ok:
        sys.exit(1)


def cmd_advance(arg, stage):
    job = advance(sync(resolve(arg)), stage)
    save(sync(job))
    print(f"{job['id']}: {job['stage']} (round {job['round']})")


def cmd_sync(arg):
    job = sync(resolve(arg))
    save(job)
    reviews = " ".join(f"{k}:{v}" for k, v in job["reviews"].items())
    print(f"{job['id']}: {job['stage']} round {job['round']} gate {job['gate'] or '-'} {reviews}".rstrip())


COMMANDS = {
    ("init", None): lambda a: cmd_init(a),
    ("queue", 0): lambda a: cmd_queue(),
    ("create", 1): lambda a: cmd_create(a[0]) if a[0].isdigit() else die("job", "usage: job create <issue>"),
    ("header", 1): lambda a: print(prompt_header(resolve(a[0]))),
    ("header", 2): lambda a: print(prompt_header(resolve(a[0]), a[1])),
    ("advance", 2): lambda a: cmd_advance(*a),
    ("merge", 1): lambda a: cmd_merge(resolve(a[0])),
    ("feedback", 1): lambda a: cmd_feedback(resolve(a[0]), sys.stdin.read()),
    ("reject", 1): lambda a: cmd_reject(resolve(a[0]), sys.stdin.read()),
    ("agents", 2): lambda a: cmd_agents(sync(resolve(a[0])), a[1]),
    ("sync", 1): lambda a: cmd_sync(a[0]),
    ("summary", None): lambda a: cmd_summary(a),
}


def main(argv):
    if not argv or argv[0] in {"-h", "--help"}:
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    handler = COMMANDS.get((cmd, None)) or COMMANDS.get((cmd, len(args)))
    if not handler:
        die("job", f"bad arguments: {' '.join(argv)}\n\n{__doc__.strip()}")
    try:
        handler(args)
    except Refused as e:
        die("job", str(e))


if __name__ == "__main__":
    main(sys.argv[1:])
